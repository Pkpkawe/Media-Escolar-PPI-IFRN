# Dependencies
# Never commit node_modules because it can be completely rebuilt using your lockfile
node_modules/
/jspm_packages
/typings

# Production Build Artifacts
# These folders contain the compiled, optimized code generated for production
dist/
build/
.next/
out/

# Environment Variables and Secrets
# Keep your API keys and private configuration safe from public repositories
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Debug and Logs
# Prevents performance-tracking logs and errors from cluttering the repository
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Testing and Coverage
# Excludes test coverage reports and snapshot testing caches
/coverage
/.nyc_output

# Editor and IDE Settings
# Excludes individual configuration files generated by your code editor
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
# System files generated by macOS or Windows file managers
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db

# Diagnostic and Cache Directories
# Temporary directories created by build tools and framework runners
.eslintcache
.stylelintcache
.turbo/
.cache/
.parcel-cache/
